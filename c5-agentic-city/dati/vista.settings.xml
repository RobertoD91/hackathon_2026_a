<viewsettings>
    <!-- Schema grafico per sumo-gui e per gli screenshot: sfondo chiaro, strade grigie, veicoli ingranditi -->
    <scheme name="napoli">
        <background backgroundColor="240,238,232" showGrid="0"/>
        <edges laneEdgeMode="0" laneShowBorders="0" showLinkDecals="1" showLinkRules="1" hideConnectors="1" widthExaggeration="1.6" minSize="1.00">
            <colorScheme name="uniform">
                <entry color="90,90,95" name="road"/>
                <entry color="200,200,200" name="sidewalk"/>
                <entry color="192,66,44" name="bike lane"/>
                <entry color="0,0,0,0" name="green verge"/>
                <entry color="150,200,200" name="waterway"/>
                <entry color="150,150,155" name="no passenger"/>
                <entry color="red" name="closed"/>
                <entry color="green" name="connector"/>
            </colorScheme>
        </edges>
        <vehicles vehicleMode="0" vehicleQuality="2" vehicle_minSize="1.00" vehicle_exaggeration="7.00" vehicle_constantSize="0" showBlinker="1"/>
        <junctions junctionMode="0" drawLinkTLIndex_show="0" drawLinkJunctionIndex_show="0" junctionID_show="0" showLane2Lane="0" drawShape="1" drawCrossingsAndWalkingareas="0"/>
        <polys poly_minSize="0.00" poly_exaggeration="1.00" poly_constantSize="0"/>
    </scheme>
</viewsettings>
