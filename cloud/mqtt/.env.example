# Configurazione del broker MQTT. Copia questo file in .env (NON versionato):
#   cp .env.example .env && chmod 600 .env
# ./scripts/inizializza.sh lo fa da sé e scrive qui le password del ponte e del monitor.
# Valori senza spazi né virgolette (le password generate sono alfanumeriche); unica eccezione
# PONTE_MAPPA, un JSON tra apici singoli.

# ------------------------------------------------------------------ dominio e TLS
MQTT_DOMINIO=twinciro.robertodisanto.it
# nessuno: MQTT solo in chiaro sulla 1883 con utente e password (scelta del team, predefinito).
# letsencrypt: accende anche 8883 (TLS) e 8884 (wss) con LETSENCRYPT_DIR/live/$MQTT_DOMINIO/.
# autofirmato: come sopra con segreti/certs-autofirmati/ (./scripts/certificati-autofirmati.sh).
MQTT_CERTIFICATI=nessuno
# Cartella con live/<dominio>/{fullchain,privkey}.pem, leggibile dall'utente che usa Docker
# (sul server non abbiamo root: vedi README, "TLS senza root"). Con TLS spento basta ./segreti.
LETSENCRYPT_DIR=./segreti

# ------------------------------------------------------------------ porte sul server
MQTT_PORTA=1883
MQTTS_PORTA=8883
WSS_PORTA=8884
# WebSocket in chiaro: solo per un reverse proxy sullo stesso server (127.0.0.1).
# 0.0.0.0 la espone a tutti (sconsigliato: password in chiaro dal browser).
WS_INDIRIZZO=127.0.0.1
WS_PORTA=9001

# ------------------------------------------------------------------ monitor (profilo "monitor")
MQTT_MONITOR_PASSWORD=
MONITOR_TOPIC=#

# ------------------------------------------------------------------ ponte MQTT -> hub (profilo "ponte")
MQTT_PONTE_PASSWORD=
# Indirizzo del hub di shared/iot-agents visto dal container (senza barra finale), es.
#   http://host.docker.internal:8701   hub sullo stesso server, fuori da Docker
#   https://hub.example.org            hub altrove
HUB_URL=http://host.docker.internal:8701
# Token del hub (variabile HUB_TOKEN del server Node). Vuoto se non usato.
HUB_TOKEN=
# Facoltative: zona per i Tasmota con FullTopic predefinito (tele/<topic>/...), mappa JSON
# dispositivo -> zona/coordinate tra apici singoli, es.
#   PONTE_MAPPA='{"tasmota-serra":{"zone":"serra","lat":40.80,"lon":14.17}}'
# e PONTE_C5=1 per inoltrare al hub anche napoli/sensori/<id>/<grandezza> (formato c5).
PONTE_ZONA_PREDEFINITA=
PONTE_MAPPA=
PONTE_C5=0
