# Configurazione del broker MQTT. Copia questo file in .env (NON versionato):
#   cp .env.example .env && chmod 600 .env
# ./scripts/inizializza.sh lo fa da sé e scrive qui le password del ponte e del monitor.
# Valori senza virgolette e senza spazi. Le password generate dagli script sono alfanumeriche.

# ------------------------------------------------------------------ dominio e certificati TLS
MQTT_DOMINIO=cloud.robertodisanto.it
# letsencrypt: usa /etc/letsencrypt/live/$MQTT_DOMINIO/ del server (già presenti, sola lettura).
# autofirmato: usa segreti/certs-autofirmati/ (./scripts/certificati-autofirmati.sh), per le prove.
MQTT_CERTIFICATI=letsencrypt
# Cartella di Let's Encrypt sul server. Con MQTT_CERTIFICATI=autofirmato metti ./segreti
# (deve solo esistere: Docker altrimenti creerebbe /etc/letsencrypt vuota).
LETSENCRYPT_DIR=/etc/letsencrypt

# ------------------------------------------------------------------ porte sul server
MQTT_PORTA=1883
MQTTS_PORTA=8883
WSS_PORTA=8884
# WebSocket in chiaro: solo per un reverse proxy sullo stesso server (127.0.0.1).
# 0.0.0.0 la espone a tutti (sconsigliato: password in chiaro dal browser).
WS_INDIRIZZO=127.0.0.1
WS_PORTA=9001

# ------------------------------------------------------------------ monitor (profilo "monitor")
MQTT_MONITOR_PASSWORD=
MONITOR_TOPIC=#

# ------------------------------------------------------------------ ponte MQTT -> hub (profilo "ponte")
MQTT_PONTE_PASSWORD=
# Indirizzo del hub di shared/iot-agents visto dal container (senza barra finale), es.
#   http://host.docker.internal:8701   hub sullo stesso server, fuori da Docker
#   https://hub.example.org            hub altrove
HUB_URL=http://host.docker.internal:8701
# Token del hub (variabile HUB_TOKEN del server Node). Vuoto se non usato.
HUB_TOKEN=
