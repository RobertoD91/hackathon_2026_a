# Configurazione dell'API dati città. Copia questo file in .env (NON versionato):
#   cp .env.example .env && chmod 600 .env
# Valori senza spazi né virgolette. Tutte le voci sono facoltative.

# ------------------------------------------------------------------ rete
# Porta sul server (nel container l'API ascolta sempre sulla 8791).
CITTA_API_PORTA=8791
# 0.0.0.0 = raggiungibile da fuori (apri la porta nel firewall del provider);
# 127.0.0.1 = solo dal server, dietro un reverse proxy (esempi/nginx-citta-api.conf).
CITTA_API_INDIRIZZO=0.0.0.0

# ------------------------------------------------------------------ accesso
# Token Bearer per CiroGPT (OpenClaw). Generalo con: openssl rand -hex 24
# Vuoto = API aperta. /salute risponde sempre senza token (healthcheck).
CITTA_API_TOKEN=
# Origini ammesse dal browser, separate da virgole (* = tutte, vuoto = nessuna).
# Una pagina pubblica non può tenere segreto un token: per la mappa lascia CITTA_API_TOKEN vuoto
# oppure metti l'API dietro un reverse proxy che aggiunge il token solo per CiroGPT.
CITTA_API_CORS=https://robertodisanto.it

# ------------------------------------------------------------------ fonti
# User-Agent verso le fonti: generico, senza dati personali. Se una fonte chiede un contatto
# (MET Norway, Transitous) usa un indirizzo del progetto, es. citta-api/1.0 (+https://robertodisanto.it)
NAPOLI_UA=
# Rinfresco degli snapshot dentro il processo: età massima per sezione (m, h, d).
# 0 = mai (restano gli snapshot dell'immagine; rigenerali a mano con aggiorna.js). Vuoto = il
# piano qui sotto, che è anche quello predefinito di compose.yaml.
CITTA_AGGIORNA=eventi=6h,aria=1h,meteo=3h,riferimenti=24h,trasporti=72h
# 1 = rilegge in anticipo ogni 5 minuti le fonti del riassunto scadute (risposte sempre pronte).
CITTA_TIENI_CALDO=1
# Pausa di un dominio dopo un 429 (o il Retry-After della fonte, se più lungo; massimo 1 h).
CITTA_PAUSA_429=15m
